{application, seppen, [
    {description, "Simple distributed in-memory key-value store"},
    {vsn, "1.0.0"},
    {modules, [
        seppen,
        seppen_dispatch,
        seppen_hash,
        seppen_health,
        seppen_rest,
        seppen_store
    ]},
    {registered, [seppen, seppen_dispatch, seppen_index, seppen_rest, seppen_store]},
    {applications, [
        kernel,
        stdlib,
        crypto,
        sasl,
        cowboy
    ]},
    {env, [{port, 21285}, {max_value_size, 1048576}]},
    {mod, {seppen, []}}
]}.
